---
interface Props {
  valor: string;
  etiqueta: string;
  detalle?: string;
  slot?: 1 | 2 | 3 | 4 | 5;
}
const { valor, etiqueta, detalle, slot } = Astro.props;
---
<div class="cifra">
  {slot && <span class={`cifra__marca cifra__marca--s${slot}`}></span>}
  <p class="cifra__valor num">{valor}</p>
  <p class="cifra__etq">{etiqueta}</p>
  {detalle && <p class="cifra__det">{detalle}</p>}
</div>
<style>
  .cifra { position: relative; padding-top: 0.9rem; border-top: 2px solid var(--ink); }
  .cifra__marca {
    position: absolute; top: -2px; left: 0; width: 2.2rem; height: 2px;
  }
  .cifra__marca--s1 { background: var(--s1); }
  .cifra__marca--s2 { background: var(--s2); }
  .cifra__marca--s3 { background: var(--s3); }
  .cifra__marca--s4 { background: var(--s4); }
  .cifra__marca--s5 { background: var(--s5); }

  .cifra__valor {
    margin: 0;
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .cifra__etq {
    margin: 0.5rem 0 0;
    font-family: var(--sans);
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--ink);
  }
  .cifra__det {
    margin: 0.3rem 0 0;
    font-family: var(--sans);
    font-size: 0.74rem;
    line-height: 1.45;
    color: var(--ink-3);
  }
</style>
